{
  "name": "reactlab-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ReactLab - Master React with an AI Voice Tutor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5180 && electron .\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "package:win": "vite build && electron-builder --win",
    "preview": "vite preview",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "audit:pedagogy": "node scripts/audit-pedagogy.mjs",
    "audio:manifest": "node scripts/generate-audio-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "electron scripts/generate-icon.cjs"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "@codesandbox/sandpack-react": "^2.19.10",
    "@tanstack/react-query": "^5.102.0",
    "acorn": "^8.14.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.4",
    "canvas-confetti": "^1.9.4",
    "diff": "^8.0.3",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "prettier": "^3.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "msedge-tts": "^2.0.7",
    "oxlint": "^1.50.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "intersection-observer": "file:./stubs/intersection-observer"
  },
  "build": {
    "appId": "com.reactlab.desktop",
    "productName": "ReactLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "ReactLab",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "msedge-tts@2.0.7": true
  }
}
